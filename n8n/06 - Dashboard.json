    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst b = item.body || {};\n\nlet status = 400;\nlet errore = 'INPUT_NON_VALIDO';\nlet messaggio = null;\n\nif (!b.ruolo) {\n  messaggio = \"Campo 'ruolo' mancante\";\n} else if (!['Responsabile', 'Amministratore'].includes(b.ruolo)) {\n  status = 403;\n  errore = 'NON_AUTORIZZATO';\n  messaggio = 'Solo Responsabile e Amministratore possono consultare la dashboard';\n}\n\nreturn [{ json: { ...item, ok: messaggio === null, status, errore, messaggio } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
