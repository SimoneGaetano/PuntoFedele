    {
      "parameters": {
        "jsCode": "// Riunisce tutti i clienti in un solo item: senza questo passaggio il nodo successivo\n// verrebbe eseguito una volta per ogni cliente e i movimenti risulterebbero duplicati.\nconst clienti = $input.all().map(i => i.json).filter(c => c && c._id);\nreturn [{ json: { clienti } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -32
      ],
      "id": "b7794158-2e6f-44c5-b505-90bc2cb84d4c",
      "name": "Code - Raccogli Clienti"
    },
    {
      "parameters": {
        "collection": "purchases_movements",
        "options": {},
        "query": "={{ JSON.stringify({}) }}"
      },
      "id": "35fff367-708c-44be-8311-59b95191d09c",
      "name": "MongoDB - Cerca Movimenti",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        976,
        -32
      ],
      "alwaysOutputData": true,
      "credentials": {
        "mongoDb": {
          "id": "8CO41cA5SdkQ0aAv",
          "name": "MongoDB account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const clienti = $('Code - Raccogli Clienti').first().json.clienti;\nconst movimenti = $input.all().map(i => i.json).filter(m => m && m._id);\n\n// un movimento è annullato se esiste un movimento \"annullamento\" che punta a lui\nconst annullati = new Set(\n  movimenti.filter(m => m.tipo === 'annullamento').map(m => String(m.movimento_originale_id))\n);\nconst validi = movimenti.filter(m => m.tipo !== 'annullamento' && !annullati.has(String(m._id)));\nconst acquisti = validi.filter(m => m.tipo === 'acquisto');\nconst riscatti = validi.filter(m => m.tipo === 'riscatto');\n\nconst somma = (lista, campo) => lista.reduce((s, m) => s + Math.abs(Number(m[campo]) || 0), 0);\nconst euro = n => Math.round(n * 100) / 100;\n\nconst clientiTop = clienti\n  .map(c => ({\n    id: String(c._id),\n    nome: c.nome,\n    cognome: c.cognome,\n    email: c.email,\n    saldo_punti: Number(c.saldo_punti) || 0\n  }))\n  .sort((a, b) => b.saldo_punti - a.saldo_punti)\n  .slice(0, 5)\n  .map((c, i) => ({ posizione: i + 1, ...c }));\n\nreturn [{ json: {\n  success: true,\n  totale_clienti: clienti.length,\n  punti_assegnati: somma(acquisti, 'punti'),\n  punti_utilizzati: somma(riscatti, 'punti'),\n  valore_acquisti: euro(somma(acquisti, 'importo_euro')),\n  numero_acquisti: acquisti.length,\n  numero_riscatti: riscatti.length,\n  clienti_top: clientiTop,\n  messaggio: 'Dashboard aggiornata'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
