    {
      "parameters": {
        "jsCode": "const cliente = $('MongoDB - Cerca Cliente').first().json;\nconst premio = $('MongoDB - Cerca Premio').first().json;\n\nconst costo = Number(premio.costo_punti);\nif (!Number.isFinite(costo) || costo <= 0) throw new Error('Costo del premio non valido');\n\nconst saldoPrecedente = Number(cliente.saldo_punti) || 0;\nif (saldoPrecedente < costo) throw new Error('Saldo insufficiente');\n\nreturn [{ json: {\n  email: cliente.email,\n  codice_cliente: cliente.codice_cliente,\n  cliente_id: String(cliente._id),\n  premio_id: String(premio._id),\n  premio_nome: premio.nome,\n  saldo_precedente: saldoPrecedente,\n  punti_usati: costo,\n  saldo_punti: saldoPrecedente - costo\n} }];"
      },
