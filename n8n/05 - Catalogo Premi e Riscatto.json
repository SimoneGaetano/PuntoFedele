    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst b = item.body || {};\nconst isId = v => typeof v === 'string' && /^[0-9a-fA-F]{24}$/.test(v);\nconst codice = String(b.codice_cliente || '').trim().toUpperCase();\nconst email = String(b.email || '').trim();\nconst filtro = codice ? { codice_cliente: codice } : { email };\n\nlet status = 400;\nlet errore = 'INPUT_NON_VALIDO';\nlet messaggio = null;\n\nif (!['catalogo', 'riscatto'].includes(b.azione)) {\n  messaggio = \"Campo 'azione' mancante o non valido (catalogo | riscatto)\";\n} else if (!codice && !email) {\n  messaggio = \"Indicare 'codice_cliente' o 'email'\";\n} else if (!b.ruolo) {\n  messaggio = \"Campo 'ruolo' mancante\";\n} else if (b.azione === 'riscatto' && !isId(b.premio_id)) {\n  messaggio = \"Campo 'premio_id' mancante o non valido\";\n} else if (b.azione === 'riscatto' && !b.operatore) {\n  messaggio = \"Campo 'operatore' mancante\";\n} else if (b.ruolo !== 'Amministratore') {\n  status = 403;\n  errore = 'NON_AUTORIZZATO';\n  messaggio = \"Solo l'Amministratore può gestire i premi\";\n}\n\nreturn [{ json: {\n  ...item,\n  ok: messaggio === null,\n  status,\n  errore,\n  messaggio,\n  filtro\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        1152
      ],
