    {
      "parameters": {
        "jsCode": "const cliente = $('MongoDB - Cerca Cliente').first().json;\nconst saldo = Number(cliente.saldo_punti) || 0;\n\nconst premi = $input.all()\n  .map(i => i.json)\n  .filter(p => p && p._id)\n  .map(p => {\n    const costo = Number(p.costo_punti) || 0;\n    return {\n      id: String(p._id),\n      nome: p.nome,\n      descrizione: p.descrizione,\n      costo_punti: costo,\n      riscattabile: saldo >= costo,\n      punti_mancanti: Math.max(0, costo - saldo)\n    };\n  })\n  .sort((a, b) => a.costo_punti - b.costo_punti);\n\nreturn [{ json: {\n  success: true,\n  azione: 'catalogo',\n  cliente: {\n    id: String(cliente._id),\n    codice_cliente: cliente.codice_cliente,\n    nome: cliente.nome,\n    cognome: cliente.cognome,\n    email: cliente.email,\n    saldo_punti: saldo\n  },\n  totale: premi.length,\n  premi,\n  messaggio: premi.length ? 'Catalogo premi recuperato' : 'Nessun premio disponibile'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
