    {
      "parameters": {
        "jsCode": "const mov = $('MongoDB - Cerca Movimento').first().json;\nconst cliente = $input.first().json;\n\nif (!cliente._id) throw new Error('Cliente del movimento non trovato: impossibile correggere il saldo');\n\nconst punti = Math.abs(Number(mov.punti) || 0);\n// annullare un acquisto toglie punti; annullare un utilizzo di punti li restituisce\nconst puntiStorno = mov.tipo === 'acquisto' ? -punti : punti;\nconst saldoPrecedente = Number(cliente.saldo_punti) || 0;\n\nreturn [{ json: {\n  email: cliente.email,\n  saldo_precedente: saldoPrecedente,\n  punti_storno: puntiStorno,\n  saldo_punti: saldoPrecedente + puntiStorno\n} }];"
      },
