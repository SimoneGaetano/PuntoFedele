    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst b = item.body || {};\nconst isId = v => typeof v === 'string' && /^[0-9a-fA-F]{24}$/.test(v);\nconst isData = v => typeof v === 'string' && !isNaN(Date.parse(v));\n\nlet status = 400;\nlet errore = 'INPUT_NON_VALIDO';\nlet messaggio = null;\n\nif (!['storico', 'annullamento'].includes(b.azione)) {\n  messaggio = \"Campo 'azione' mancante o non valido (storico | annullamento)\";\n} else if (b.azione === 'storico') {\n  // tutti i filtri sono opzionali\n  if (b.cliente_id && !isId(b.cliente_id)) messaggio = \"'cliente_id' non valido\";\n  else if (b.data_da && !isData(b.data_da)) messaggio = \"'data_da' non valida (usa YYYY-MM-DD)\";\n  else if (b.data_a && !isData(b.data_a)) messaggio = \"'data_a' non valida (usa YYYY-MM-DD)\";\n} else {\n  if (!isId(b.movimento_id)) messaggio = \"Campo 'movimento_id' mancante o non valido\";\n  else if (!b.ruolo) messaggio = \"Campo 'ruolo' mancante\";\n  else if (!b.operatore) messaggio = \"Campo 'operatore' mancante\";\n  else if (b.ruolo !== 'Amministratore') {\n    status = 403;\n    errore = 'NON_AUTORIZZATO';\n    messaggio = \"Solo l'Amministratore può annullare operazioni\";\n  }\n}\n\nreturn [{ json: {\n  ...item,\n  ok: messaggio === null,\n  status,\n  errore,\n  messaggio,\n  filtro: b.cliente_id ? { cliente_id: String(b.cliente_id) } : {}\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
