    {
      "parameters": {
        "jsCode": "const b = $('Webhook Movimenti').first().json.body;\nconst tutti = $input.all().map(i => i.json).filter(m => m && m._id);\n\nconst da = b.data_da ? new Date(b.data_da) : null;\nconst a = b.data_a ? new Date(b.data_a) : null;\nif (a && String(b.data_a).length <= 10) a.setUTCHours(23, 59, 59, 999); // include l'intero giorno finale\n\n// un movimento è annullato se esiste un movimento \"annullamento\" che punta a lui\nconst annullati = new Set(\n  tutti.filter(m => m.tipo === 'annullamento').map(m => String(m.movimento_originale_id))\n);\n\nconst movimenti = tutti\n  .filter(m => !b.tipo || m.tipo === b.tipo)\n  .filter(m => {\n    const d = new Date(m.data);\n    return (!da || d >= da) && (!a || d <= a);\n  })\n  .map(m => ({ ...m, _id: String(m._id), annullato: annullati.has(String(m._id)) }))\n  .sort((x, y) => new Date(y.data) - new Date(x.data));\n\nreturn [{ json: {\n  success: true,\n  azione: 'storico',\n  totale: movimenti.length,\n  movimenti,\n  messaggio: movimenti.length ? 'Storico movimenti recuperato' : 'Nessun movimento trovato con i filtri indicati'\n} }];"
      },
