    {
      "parameters": {
        "jsCode": "const cliente = $('MongoDB - Cerca Cliente').first().json;\n\n// ultimi 5 movimenti, dal più recente (la data può essere Date o testo ISO)\nconst movimenti = $input.all()\n  .map(i => i.json)\n  .filter(m => m && m._id)\n  .map(m => ({ ...m, _id: String(m._id) }))\n  .sort((a, b) => new Date(b.data) - new Date(a.data))\n  .slice(0, 5);\n\nreturn [{ json: {\n  success: true,\n  cliente: {\n    id: String(cliente._id),\n    codice_cliente: cliente.codice_cliente,\n    nome: cliente.nome,\n    cognome: cliente.cognome,\n    email: cliente.email,\n    saldo_punti: cliente.saldo_punti\n  },\n  movimenti,\n  messaggio: 'Cliente trovato'\n} }];"
      },
