      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst b = item.body || {};\nconst codice = String(b.codice_cliente || '').trim().toUpperCase();\nconst email = String(b.email || '').trim();\nconst filtro = codice ? { codice_cliente: codice } : { email };\nconst importo = Number(b.importo_euro);\nconst importoOk = ['number', 'string'].includes(typeof b.importo_euro) && Number.isFinite(importo) && importo > 0;\n\nlet messaggio = null;\nif (!codice && !email) messaggio = \"Indicare 'codice_cliente' o 'email'\";\nelse if (!importoOk) messaggio = \"Campo 'importo_euro' mancante o non valido (deve essere un numero maggiore di 0)\";\n\nreturn [{ json: {\n  ...item,\n  ok: messaggio === null,\n  errore: 'INPUT_NON_VALIDO',\n  messaggio,\n  filtro,\n  importo_euro: importoOk ? importo : 0,\n  punti: importoOk ? Math.floor(importo) : 0,   // regola: 1 euro = 1 punto (decimali scartati)\n  operatore: String(b.operatore || 'operatore').trim()\n} }];"
      },
      "type": "n8n-nodes-base.code",
